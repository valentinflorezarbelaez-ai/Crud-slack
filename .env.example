# Opaque credential handles only — never commit real values (Law VI / IA-5).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional. When unset, derived as https://<DATABASE_URL host>/sql
# NEON_SQL_URL=https://HOST/sql

# Neon Managed Better Auth (pulled via `neon deploy` / `neon env pull`)
NEON_AUTH_BASE_URL=https://HOST/neondb/auth

# IA-5 authenticators (required in production / auth paths)
SESSION_SECRET=replace-with-cryptographically-random-min-32-chars
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com

# Server-only model key — never embed in client bundles
# GEMINI_API_KEY=replace-via-host-secret-store-and-rotate-if-exposed
